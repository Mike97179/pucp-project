# ------------------------------------------------------------------
# Entorno y basura de Python
# ------------------------------------------------------------------
.pucp-project/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.env

# ------------------------------------------------------------------
# Modelos base de YOLO (pretrained): pesan mucho y se descargan solos
# ------------------------------------------------------------------
/yolo*.pt

# Cache de anotaciones de Ultralytics (dataset/labels.cache)
*.cache
# Salida cruda de los entrenamientos
runs/

# Dataset completo (366 MB de imágenes + anotaciones).
# Se conserva solo data.yaml, que define las 7 clases y lo lee config.py.
dataset/*
!dataset/data.yaml

# ------------------------------------------------------------------
# Imágenes: todas se regeneran con los comandos del proyecto
# ------------------------------------------------------------------
# benchmark_results/  -> `benchmark` (74 MB de JPEG de predicciones)
# confusion_matrices/ -> `matrices`
*.jpg
*.jpeg
*.png
*.bmp
*.gif
*.webp
*.tif
*.tiff

# ------------------------------------------------------------------
# Lo que sí se sube de models/
# ------------------------------------------------------------------
# models/models.csv             el registro (leaderboard de 5)
# models/<nombre>/args.yaml     configuración de cada entrenamiento
# models/<nombre>/results.csv   curvas de entrenamiento
# models/dataset_state.txt      fingerprint del dataset

# ------------------------------------------------------------------
# Sistema operativo y editores
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
